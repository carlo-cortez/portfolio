---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, initials } from '../site.config';
import { getCollection } from 'astro:content';

const skills = [
  { label: 'Languages', items: ['JavaScript', 'TypeScript', 'Python', 'HTML & CSS', 'SQL'] },
  { label: 'Frontend', items: ['Astro', 'React', 'Tailwind CSS', 'Next.js', 'Vite'] },
  { label: 'Backend & Tools', items: ['Node.js', 'Express', 'PostgreSQL', 'Git', 'Docker', 'Vercel'] },
];
const { github, linkedin, email, resume } = site.links;

// Only link a skill to the projects page if at least one project mentions it
const projectText = (await getCollection('projects'))
  .map((p) => [p.data.title, p.data.description, ...p.data.tags].join(' ').toLowerCase());
const hasProjects = (skill: string) => projectText.some((t) => t.includes(skill.toLowerCase()));
---

<BaseLayout title={`About — ${site.name}`} description={`About ${site.name}: background, skills, and how to get in touch.`}>
  <div class="container about-wrap">
    <section class="about-hero" aria-labelledby="about-heading">
      <div class="avatar" aria-hidden="true">{initials}</div>
      <div class="about-bio">
        <p class="section-label">About</p>
        <h1 id="about-heading">Hi, I'm {site.shortName}.</h1>
        <p>
          I'm a {site.role.toLowerCase()} with a passion for building clean, fast, and accessible web experiences.
          I focus on intuitive interfaces backed by reliable, scalable architecture.
        </p>
        <p>
          I love exploring modern web technologies, optimizing performance, and crafting delightful interactions.
          When I'm not coding, I'm learning new tools or tinkering with open-source ideas.
        </p>
        <div class="bio-actions">
          {resume && <a href={resume} class="btn btn-primary btn-sm" download><Icon name="download" size={14} /> Download résumé</a>}
          {github && <a href={github} target="_blank" rel="noopener" class="btn btn-secondary btn-sm"><Icon name="github" size={14} /> GitHub</a>}
          <a href="/projects" class="btn btn-secondary btn-sm"><Icon name="grid" size={14} /> See my work</a>
        </div>
      </div>
    </section>

    <section class="skills" aria-labelledby="skills-heading">
      <h2 id="skills-heading" class="section-h">Skills &amp; technologies</h2>
      <div class="skill-groups">
        {skills.map((group) => (
          <div class="skill-group">
            <h3 class="skill-group-label">{group.label}</h3>
            <ul class="skill-pills">
              {group.items.map((s) => (
                <li>
                  {hasProjects(s)
                    ? <a class="skill-pill" href={`/projects?q=${encodeURIComponent(s.toLowerCase())}`} title={`See projects using ${s}`}>{s}</a>
                    : <span class="skill-pill">{s}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="contact-card" id="contact" aria-labelledby="contact-heading">
      <p class="section-label">Contact</p>
      <h2 id="contact-heading">Let's work together</h2>
      <p class="contact-sub">I'm always open to discussing new projects, creative ideas, or opportunities to collaborate.</p>
      <div class="contact-links">
        {email && (
          <>
            <a href={`mailto:${email}`} class="btn btn-primary"><Icon name="mail" /> Email me</a>
            <button type="button" class="btn btn-secondary" id="copyEmail" data-email={email}>
              <span class="copy-label">Copy email</span>
            </button>
          </>
        )}
        {linkedin && <a href={linkedin} target="_blank" rel="noopener" class="btn btn-secondary"><Icon name="linkedin" /> LinkedIn</a>}
        {github && <a href={github} target="_blank" rel="noopener" class={`btn ${email ? 'btn-secondary' : 'btn-primary'}`}><Icon name="github" /> GitHub</a>}
      </div>
      <p class="copy-status sr-only" aria-live="polite" id="copyStatus"></p>
    </section>
  </div>
</BaseLayout>

<style>
  .about-wrap { padding-top: 64px; padding-bottom: 80px; display: flex; flex-direction: column; gap: 72px; }
  .about-hero { display: grid; grid-template-columns: auto 1fr; gap: 48px; align-items: start; padding: 0; }
  .avatar {
    width: 160px; height: 160px; border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), #a855f7);
    display: flex; align-items: center; justify-content: center;
    font-size: 3rem; font-weight: 800; color: #fff;
    box-shadow: 0 10px 40px color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .about-bio h1 { font-size: clamp(1.9rem, 4vw, 2.5rem); font-weight: 800; letter-spacing: -0.03em; margin-bottom: 16px; }
  .about-bio p:not(.section-label) { color: var(--text-muted); margin-bottom: 14px; max-width: 62ch; }
  .bio-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 24px; }

  .skills { padding: 0; }
  .section-h { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 24px; }
  .skill-groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 28px; }
  .skill-group-label {
    font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--text-muted); margin-bottom: 12px;
  }
  .skill-pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .skill-pill {
    display: inline-block;
    padding: 6px 14px; border-radius: var(--radius-pill);
    font-size: 0.85rem; font-weight: 500;
    background: var(--surface); border: 1px solid var(--border); color: var(--text);
    transition: border-color var(--transition), color var(--transition), background var(--transition);
  }
  a.skill-pill:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-light); }

  .contact-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 48px;
    text-align: center;
  }
  .contact-card h2 { font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 10px; }
  .contact-sub { color: var(--text-muted); max-width: 460px; margin: 0 auto; }
  .contact-links { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; margin-top: 28px; }

  @media (max-width: 767px) {
    .about-wrap { padding-top: 40px; gap: 56px; }
    .about-hero { grid-template-columns: 1fr; gap: 24px; }
    .avatar { width: 112px; height: 112px; font-size: 2.2rem; }
    .contact-card { padding: 32px 20px; }
  }
</style>

<script is:inline>
  (() => {
    const btn = document.getElementById('copyEmail');
    if (!btn || !navigator.clipboard) { btn?.remove(); return; }
    const label = btn.querySelector('.copy-label');
    const status = document.getElementById('copyStatus');
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.email);
        label.textContent = 'Copied!';
        status.textContent = 'Email address copied to clipboard';
      } catch {
        label.textContent = 'Copy failed';
      }
      setTimeout(() => { label.textContent = 'Copy email'; status.textContent = ''; }, 2000);
    });
  })();
</script>
