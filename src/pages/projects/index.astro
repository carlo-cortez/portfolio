---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';
import { site } from '../../site.config';

const projects = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Tags sorted by how many projects use them (most common first)
const tagCounts = new Map<string, number>();
projects.flatMap((p) => p.data.tags).forEach((t) => tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1));
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout title={`Projects — ${site.name}`} description="Browse all software projects, case studies, and experiments.">
  <div class="container page-header">
    <div>
      <p class="section-label">Portfolio</p>
      <h1>All projects</h1>
      <p class="count" id="projectCount" aria-live="polite">Showing all {projects.length} projects</p>
    </div>
    <div class="search-box" role="search">
      <label for="searchInput" class="sr-only">Search projects</label>
      <span class="search-icon"><Icon name="search" /></span>
      <input type="search" id="searchInput" placeholder="Search by name or tech…" autocomplete="off" />
      <kbd class="search-kbd" aria-hidden="true">/</kbd>
    </div>
  </div>

  <section class="projects-section">
    <div class="container">
      <div class="tag-filter" role="group" aria-label="Filter by technology">
        <button type="button" class="filter-pill" data-tag="all" aria-pressed="true">All <span>{projects.length}</span></button>
        {tags.map(([tag, n]) => (
          <button type="button" class="filter-pill" data-tag={tag} aria-pressed="false">{tag} <span>{n}</span></button>
        ))}
      </div>

      <ul class="projects-grid" id="projectsGrid">
        {projects.map((p) => (
          <li
            class="project-item"
            data-tags={JSON.stringify(p.data.tags)}
            data-search={[p.data.title, p.data.description, ...p.data.tags].join(' ').toLowerCase()}
          >
            <ProjectCard
              title={p.data.title}
              description={p.data.description}
              tags={p.data.tags}
              slug={p.slug}
              date={p.data.date}
              image={p.data.image}
              github={p.data.github}
              live={p.data.live}
              headingLevel="h2"
            />
          </li>
        ))}
      </ul>

      <div id="noResults" class="no-results" hidden>
        <Icon name="search" size={40} />
        <h2>No projects found</h2>
        <p>Try a different keyword or technology.</p>
        <button id="resetBtn" type="button" class="btn btn-secondary btn-sm">Clear filters</button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-top: 56px;
    display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap;
  }
  .page-header h1 { font-size: 2.5rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; }
  .count { font-size: 0.9rem; color: var(--text-muted); margin-top: 6px; }

  .search-box { position: relative; width: min(100%, 320px); }
  .search-icon {
    position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
    display: inline-flex; color: var(--text-muted); pointer-events: none;
  }
  .search-box input {
    width: 100%;
    min-height: 44px;
    padding: 10px 40px 10px 40px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font: inherit; font-size: 0.9rem;
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .search-box input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent); }
  .search-kbd {
    position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
    font-family: inherit; font-size: 0.72rem; font-weight: 600;
    padding: 1px 7px; border-radius: 5px;
    border: 1px solid var(--border); color: var(--text-muted); background: var(--bg);
    pointer-events: none;
  }
  .search-box input:focus ~ .search-kbd,
  .search-box input:not(:placeholder-shown) ~ .search-kbd { display: none; }

  .projects-section { padding-top: 28px; }
  .tag-filter { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px; }
  .filter-pill {
    display: inline-flex; align-items: center; gap: 6px;
    min-height: 36px;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    font-size: 0.85rem; font-weight: 600;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
    transition: background var(--transition), border-color var(--transition), color var(--transition);
  }
  .filter-pill span {
    font-size: 0.72rem; padding: 0 6px; border-radius: var(--radius-pill);
    background: var(--bg); color: var(--text-muted);
  }
  .filter-pill:hover { border-color: var(--accent); color: var(--accent); }
  .filter-pill[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: #fff; }
  :global([data-theme="dark"]) .filter-pill[aria-pressed="true"] { color: #0f172a; }
  .filter-pill[aria-pressed="true"] span { background: rgba(255,255,255,.25); color: inherit; }

  .projects-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }
  .project-item[hidden] { display: none; }

  .no-results {
    text-align: center; padding: 64px 20px;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    display: flex; flex-direction: column; align-items: center; gap: 8px;
  }
  .no-results[hidden] { display: none; }
  .no-results h2 { color: var(--text); font-size: 1.25rem; font-weight: 700; }
  .no-results .btn { margin-top: 8px; }

  @media (max-width: 767px) {
    .page-header { flex-direction: column; align-items: stretch; padding-top: 40px; }
    .search-box { width: 100%; }
    .search-kbd { display: none; }
    .tag-filter { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 6px; scrollbar-width: thin; }
    .filter-pill { flex-shrink: 0; }
  }
  @media (max-width: 480px) {
    .projects-grid { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  (() => {
    const input = document.getElementById('searchInput');
    const pills = [...document.querySelectorAll('.filter-pill')];
    const items = [...document.querySelectorAll('.project-item')];
    const count = document.getElementById('projectCount');
    const empty = document.getElementById('noResults');
    const total = items.length;

    // Restore state from the URL so filtered views can be shared / bookmarked
    const params = new URLSearchParams(location.search);
    let tag = pills.some((p) => p.dataset.tag === params.get('tag')) ? params.get('tag') : 'all';
    let query = (params.get('q') || '').trim();
    input.value = query;

    function apply(updateUrl = true) {
      const q = query.toLowerCase();
      let visible = 0;
      for (const item of items) {
        const tags = JSON.parse(item.dataset.tags);
        const show = (tag === 'all' || tags.includes(tag)) && (!q || item.dataset.search.includes(q));
        item.hidden = !show;
        if (show) visible++;
      }
      pills.forEach((p) => p.setAttribute('aria-pressed', String(p.dataset.tag === tag)));
      count.textContent = visible === total
        ? `Showing all ${total} projects`
        : `Showing ${visible} of ${total} project${total === 1 ? '' : 's'}`;
      empty.hidden = visible !== 0;

      if (updateUrl) {
        const p = new URLSearchParams();
        if (tag !== 'all') p.set('tag', tag);
        if (query) p.set('q', query);
        history.replaceState(null, '', p.toString() ? `?${p}` : location.pathname);
      }
    }

    pills.forEach((pill) => pill.addEventListener('click', () => { tag = pill.dataset.tag; apply(); }));
    input.addEventListener('input', () => { query = input.value.trim(); apply(); });
    document.getElementById('resetBtn').addEventListener('click', () => {
      tag = 'all'; query = ''; input.value = ''; apply(); input.focus();
    });

    // Press "/" anywhere to jump to search
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && !/INPUT|TEXTAREA/.test(document.activeElement.tagName)) {
        e.preventDefault(); input.focus();
      }
    });

    apply(false);
  })();
</script>
