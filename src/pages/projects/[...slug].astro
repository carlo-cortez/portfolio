---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { gradientFor } from '../../lib/gradient';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      newer: i > 0 ? projects[i - 1] : null,
      older: i < projects.length - 1 ? projects[i + 1] : null,
    },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  newer: CollectionEntry<'projects'> | null;
  older: CollectionEntry<'projects'> | null;
}

const { project, newer, older } = Astro.props;
const { data } = project;
const { Content } = await project.render();

const formattedDate = data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
const minutes = Math.max(1, Math.round(project.body.trim().split(/\s+/).length / 200));
---

<BaseLayout title={`${data.title} — ${site.name}`} description={data.description}>
  <article class="container detail-wrap">
    <a href="/projects" class="back-link"><Icon name="arrow-left" /> All projects</a>

    <header class="detail-header">
      <p class="detail-meta">
        <time datetime={data.date.toISOString()}>{formattedDate}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
      </p>
      <h1 class="detail-title">{data.title}</h1>
      <p class="detail-lede">{data.description}</p>

      <ul class="detail-tags" aria-label="Technologies">
        {data.tags.map((tag) => (
          <li><a class="tag tag-link" href={`/projects?tag=${encodeURIComponent(tag)}`}>{tag}</a></li>
        ))}
      </ul>

      {(data.live || data.github) && (
        <div class="detail-actions">
          {data.live && (
            <a href={data.live} target="_blank" rel="noopener" class="btn btn-primary">
              <Icon name="external" /> View live site
            </a>
          )}
          {data.github && (
            <a href={data.github} target="_blank" rel="noopener" class="btn btn-secondary">
              <Icon name="github" /> Source code
            </a>
          )}
        </div>
      )}
    </header>

    <div class="hero-media" style={data.image ? undefined : `background: ${gradientFor(project.slug)};`}>
      {data.image && <img src={data.image} alt={`Screenshot of ${data.title}`} fetchpriority="high" />}
    </div>

    <div class="prose">
      <Content />
    </div>

    <nav class="project-nav" aria-label="More projects">
      {older ? (
        <a href={`/projects/${older.slug}`} class="nav-card">
          <span class="nav-direction"><Icon name="arrow-left" size={14} /> Previous</span>
          <span class="nav-title">{older.data.title}</span>
        </a>
      ) : <span />}
      {newer ? (
        <a href={`/projects/${newer.slug}`} class="nav-card nav-next">
          <span class="nav-direction">Next <Icon name="arrow-right" size={14} /></span>
          <span class="nav-title">{newer.data.title}</span>
        </a>
      ) : <span />}
    </nav>
  </article>
</BaseLayout>

<style>
  .detail-wrap { max-width: 820px; padding-top: 40px; padding-bottom: 80px; }
  .back-link {
    display: inline-flex; align-items: center; gap: 6px;
    min-height: 40px;
    font-size: 0.9rem; font-weight: 500; color: var(--text-muted);
    margin-bottom: 24px;
    transition: color var(--transition), gap var(--transition);
  }
  .back-link:hover { color: var(--accent); gap: 10px; }

  .detail-meta { display: flex; gap: 8px; font-size: 0.875rem; color: var(--text-muted); margin-bottom: 10px; }
  .detail-title {
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 800; letter-spacing: -0.03em; line-height: 1.1;
    text-wrap: balance;
  }
  .detail-lede { font-size: 1.15rem; color: var(--text-muted); margin-top: 14px; text-wrap: pretty; }
  .detail-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 20px; }
  .tag-link { transition: background var(--transition), color var(--transition); }
  .tag-link:hover { background: var(--accent); color: #fff; }
  .detail-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }

  .hero-media {
    margin: 40px 0;
    aspect-ratio: 21 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    position: relative;
  }
  .hero-media:not(:has(img))::before {
    content: '';
    position: absolute; inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.08'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/svg%3E");
  }
  .hero-media img { width: 100%; height: 100%; object-fit: cover; }

  .prose { font-size: 1.05rem; line-height: 1.8; }
  .prose :global(h2) { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.01em; margin: 40px 0 14px; color: var(--text); }
  .prose :global(h3) { font-size: 1.2rem; font-weight: 600; margin: 28px 0 10px; color: var(--text); }
  .prose :global(p) { margin-bottom: 20px; color: var(--text-muted); }
  .prose :global(ul), .prose :global(ol) { padding-left: 24px; margin-bottom: 24px; }
  .prose :global(ul li) { list-style: disc; }
  .prose :global(ol li) { list-style: decimal; }
  .prose :global(li) { margin-bottom: 8px; color: var(--text-muted); }
  .prose :global(li::marker) { color: var(--accent); }
  .prose :global(strong) { color: var(--text); font-weight: 600; }
  .prose :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(code) {
    background: var(--surface); padding: 2px 6px; border-radius: 4px;
    font-size: 0.9em; border: 1px solid var(--border);
  }
  .prose :global(img) { border-radius: var(--radius-sm); margin: 24px 0; }

  .project-nav {
    display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
    margin-top: 56px; padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  .nav-card {
    display: flex; flex-direction: column; gap: 4px;
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    transition: transform var(--transition), border-color var(--transition);
  }
  .nav-card:hover { transform: translateY(-2px); border-color: var(--accent); }
  .nav-next { text-align: right; align-items: flex-end; }
  .nav-direction { display: inline-flex; align-items: center; gap: 4px; font-size: 0.8rem; font-weight: 600; color: var(--accent); }
  .nav-title { font-weight: 700; color: var(--text); }

  @media (max-width: 640px) {
    .hero-media { aspect-ratio: 16 / 9; margin: 28px 0; }
    .project-nav { grid-template-columns: 1fr; }
    .nav-next { text-align: left; align-items: flex-start; }
  }
</style>
