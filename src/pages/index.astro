---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { site } from '../site.config';

const all = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = all.filter((p) => p.data.featured);
// Never show an empty section: fall back to the most recent projects.
const shown = (featured.length ? featured : all).slice(0, 3);
const techCount = new Set(all.flatMap((p) => p.data.tags)).size;
---

<BaseLayout title={`${site.name} — ${site.role}`}>
  <section class="hero">
    <div class="container">
      {site.availableForWork && (
        <p class="avail-badge"><span class="avail-dot" aria-hidden="true"></span> Available for work</p>
      )}
      <h1>Hi, I'm <span>{site.name}</span></h1>
      <p class="hero-sub">{site.tagline}</p>
      <div class="hero-btns">
        <a href="/projects" class="btn btn-primary"><Icon name="grid" /> View my projects</a>
        <a href="/about#contact" class="btn btn-secondary">Get in touch</a>
      </div>
      <dl class="hero-stats">
        <div><dt>Projects</dt><dd>{all.length}</dd></div>
        <div><dt>Technologies</dt><dd>{techCount}</dd></div>
        <div><dt>Latest</dt><dd>{all[0]?.data.date.getFullYear() ?? '—'}</dd></div>
      </dl>
    </div>
  </section>

  <section class="featured" aria-labelledby="featured-heading">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="section-label">Work</p>
          <h2 class="section-title" id="featured-heading">{featured.length ? 'Featured projects' : 'Recent projects'}</h2>
          <p class="section-sub">A selection of things I've built recently.</p>
        </div>
        <a href="/projects" class="view-all">View all {all.length} projects <Icon name="arrow-right" size={14} /></a>
      </div>
      <div class="projects-grid">
        {shown.map((p) => (
          <ProjectCard
            title={p.data.title}
            description={p.data.description}
            tags={p.data.tags}
            slug={p.slug}
            date={p.data.date}
            image={p.data.image}
            github={p.data.github}
            live={p.data.live}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container cta-inner">
      <div>
        <h2>Have a project in mind?</h2>
        <p>I'm always happy to talk about new ideas, collaborations, or opportunities.</p>
      </div>
      <a href="/about#contact" class="btn btn-primary">Let's talk <Icon name="arrow-right" /></a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 96px 0 72px;
    text-align: center;
    background: radial-gradient(ellipse 80% 60% at 50% -10%, var(--accent-light) 0%, transparent 70%);
  }
  .hero h1 {
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.1;
    margin-bottom: 20px;
    text-wrap: balance;
  }
  .hero h1 span { color: var(--accent); }
  .hero-sub {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--text-muted);
    max-width: 540px;
    margin: 0 auto 36px;
    text-wrap: pretty;
  }
  .hero-btns { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; }
  .avail-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: #dcfce7; color: #166534;
    border-radius: var(--radius-pill);
    padding: 5px 14px; font-size: 0.8rem; font-weight: 700;
    margin-bottom: 24px;
  }
  :global([data-theme="dark"]) .avail-badge { background: #14532d; color: #bbf7d0; }
  .avail-dot { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; animation: pulse 2s infinite; }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }

  .hero-stats {
    display: flex; justify-content: center; gap: 48px;
    margin-top: 56px;
  }
  .hero-stats div { display: flex; flex-direction: column-reverse; align-items: center; }
  .hero-stats dd { font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1.2; }
  .hero-stats dt { font-size: 0.8rem; color: var(--text-muted); font-weight: 500; }

  .featured { background: var(--bg-alt); }
  .section-header {
    display: flex; align-items: flex-end; justify-content: space-between;
    margin-bottom: 40px; gap: 16px; flex-wrap: wrap;
  }
  .section-title { font-size: 1.875rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; }
  .section-sub { color: var(--text-muted); margin-top: 8px; }
  .view-all {
    font-size: 0.92rem; font-weight: 600; color: var(--accent);
    display: inline-flex; align-items: center; gap: 6px;
    transition: gap var(--transition);
  }
  .view-all:hover { gap: 10px; }
  .projects-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }

  .cta-inner {
    display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap;
    padding-top: 40px; padding-bottom: 40px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .cta h2 { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em; }
  .cta p { color: var(--text-muted); margin-top: 4px; }

  @media (max-width: 767px) {
    .hero { padding: 64px 0 48px; }
    .hero-stats { gap: 28px; margin-top: 40px; }
    .cta-inner { margin: 0 24px; padding: 28px 24px; }
  }
  @media (max-width: 480px) {
    .hero-btns { flex-direction: column; align-items: stretch; }
    .projects-grid { grid-template-columns: 1fr; }
  }
</style>
