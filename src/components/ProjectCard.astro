---
import Icon from './Icon.astro';
import { gradientFor } from '../lib/gradient';

interface Props {
  title: string;
  description: string;
  tags: string[];
  slug: string;
  date: Date;
  image?: string;
  github?: string;
  live?: string;
  headingLevel?: 'h2' | 'h3';
}

const { title, description, tags, slug, date, image, github, live, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const initials = title.split(' ').map((w) => w[0]).join('').slice(0, 2).toUpperCase();
---

<article class="card">
  <div class="card-img" style={image ? undefined : `background: ${gradientFor(slug)};`}>
    {image ? <img src={image} alt="" loading="lazy" decoding="async" /> : <span aria-hidden="true">{initials}</span>}
  </div>
  <div class="card-body">
    <div class="card-meta">
      <time datetime={date.toISOString()}>{date.getFullYear()}</time>
    </div>
    <Heading class="card-title">
      <!-- Stretched link: the whole card is clickable, but the GitHub / Live links below still work -->
      <a href={`/projects/${slug}`} class="card-link-main">{title}</a>
    </Heading>
    <p class="card-desc">{description}</p>
    <ul class="card-tags" aria-label="Technologies">
      {tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
    <div class="card-footer">
      <span class="card-more" aria-hidden="true">View details <Icon name="arrow-right" size={14} /></span>
      <div class="card-ext">
        {github && (
          <a href={github} target="_blank" rel="noopener" class="ext-link" aria-label={`${title} on GitHub (opens in new tab)`}>
            <Icon name="github" size={16} />
          </a>
        )}
        {live && (
          <a href={live} target="_blank" rel="noopener" class="ext-link" aria-label={`${title} live site (opens in new tab)`}>
            <Icon name="external" size={16} />
          </a>
        )}
      </div>
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--card-shadow);
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .card:hover, .card:focus-within {
    transform: translateY(-4px);
    box-shadow: var(--card-shadow-hover);
    border-color: var(--accent);
  }
  .card-img {
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.92);
    letter-spacing: -0.03em;
    background: var(--surface);
    overflow: hidden;
  }
  .card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .card:hover .card-img img { transform: scale(1.04); }
  .card-body {
    padding: 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .card-meta { font-size: 0.78rem; font-weight: 600; color: var(--text-muted); }
  .card-title { font-size: 1.08rem; font-weight: 700; line-height: 1.35; }
  .card-link-main { color: var(--text); }
  .card-link-main::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .card-link-main:focus-visible { outline: none; }
  .card:has(.card-link-main:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .card-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.55;
    flex: 1;
  }
  .card-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    margin-top: 4px;
  }
  .card-more {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    transition: gap var(--transition);
  }
  .card:hover .card-more { gap: 8px; }
  .card-ext { display: flex; gap: 4px; }
  .ext-link {
    position: relative;
    z-index: 2; /* sits above the stretched link */
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    transition: color var(--transition), background var(--transition);
  }
  .ext-link:hover { color: var(--accent); background: var(--surface); }
</style>
